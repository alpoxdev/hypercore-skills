{
  "name": "@hypercore/skill-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "checkjs": "bunx tsc --project tsconfig.scripts.json",
    "test": "bun test tests",
    "test:vercel-skills": "bun test tests/vercel-skills-lifecycle.test.mjs",
    "validate": "bun validate-skills.mjs",
    "validate:vercel-skills": "node validate-vercel-skills.mjs",
    "test:vercel-skills:live": "HYPERCORE_ENABLE_VERCEL_SKILLS_LIVE_GATE=1 bun test tests/vercel-skills-lifecycle.test.mjs",
    "validate:vercel-skills:registry": "HYPERCORE_ENABLE_VERCEL_SKILLS_LIVE_GATE=1 node validate-vercel-skills.mjs --live",
    "validate:vercel-skills:live": "bun run test:vercel-skills:live && bun run validate:vercel-skills:registry",
    "verify": "bun run checkjs && bun run test && bun run validate && bun run validate:vercel-skills"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  }
}
