{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-console": "off",
    "no-await-in-loop": "off",
    "no-shadow": "off",
    "vitest/expect-expect": "off",
    "vitest/require-to-throw-message": "off"
  },
  "env": {
    "builtin": true
  }
}
